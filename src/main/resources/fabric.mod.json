{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": "%FABRIC_AUTHORS_ARRAY%",
    "contact": {
        "homepage": "${mod_home_url}",
        "sources": "${mod_source_url}",
        "issues": "${mod_issues_url}"
    },
    "license": "${copyright_licence}",
    "environment": "client",
    "entrypoints": {
        "client": [
            "io.github.liam0999.civmod.CivModClient"
        ],
        "modmenu": [
            "io.github.liam0999.civmod.gui.ModMenuIntegration"
        ]
    },
    "depends": {
        "minecraft": "${minecraft_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "cloth-config": ">=${cloth_config_version}"
    },
    "accessWidener": "civmod.accesswidener",
    "mixins": [
        "civmod.mixins.json"
    ]
}
